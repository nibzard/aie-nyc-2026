ure":0.0,"avg_logprob":-0.34831205010414124,"compression_ratio":1.627450942993164,"no_speech_prob":0.02297460101544857},{"id":28,"seek":8772,"start":100.5999984741211,"end":103.31999969482422,"text":" like, in some ways, there's been 10 years of technological advancement.","tokens":[51008,411,11,294,512,2098,11,456,311,668,1266,924,295,18439,35764,13,51144],"temperature":0.0,"avg_logprob":-0.34831205010414124,"compression_ratio":1.627450942993164,"no_speech_prob":0.02297460101544857},{"id":29,"seek":8772,"start":103.31999969482422,"end":104.31999969482422,"text":" Great.","tokens":[51144,3769,13,51194],"temperature":0.0,"avg_logprob":-0.34831205010414124,"compression_ratio":1.627450942993164,"no_speech_prob":0.02297460101544857},{"id":30,"seek":8772,"start":104.31999969482422,"end":106.31999969482422,"text":" We only have a minute or so left.","tokens":[51194,492,787,362,257,3456,420,370,1411,13,51294],"temperature":0.0,"avg_logprob":-0.34831205010414124,"compression_ratio":1.627450942993164,"no_speech_prob":0.02297460101544857},{"id":31,"seek":8772,"start":106.31999969482422,"end":108.55999755859375,"text":" Is there any closing remarks you have?","tokens":[51294,1119,456,604,10377,19151,291,362,30,51406],"temperature":0.0,"avg_logprob":-0.34831205010414124,"compression_ratio":1.627450942993164,"no_speech_prob":0.02297460101544857},{"id":32,"seek":8772,"start":108.55999755859375,"end":114.63999938964844,"text":" The one thing I'd leave the audience on, if you want good takeaways from this, we talked","tokens":[51406,440,472,551,286,1116,1856,264,4034,322,11,498,291,528,665,45584,490,341,11,321,2825,51710],"temperature":0.0,"avg_logprob":-0.34831205010414124,"compression_ratio":1.627450942993164,"no_speech_prob":0.02297460101544857},{"id":33,"seek":8772,"start":114.63999938964844,"end":117.16000366210938,"text":" about a lot of very interesting things.","tokens":[51710,466,257,688,295,588,1880,721,13,51836],"temperature":0.0,"avg_logprob":-0.34831205010414124,"compr