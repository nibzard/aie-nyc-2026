ssion_ratio":1.5199999809265137,"no_speech_prob":0.0004509045393206179},{"id":61,"seek":19506,"start":205.97999572753906,"end":208.02000427246094,"text":" You're just getting the weights and putting them","tokens":[50910,509,434,445,1242,264,17443,293,3372,552,51012],"temperature":0.0,"avg_logprob":-0.24818584322929382,"compression_ratio":1.5199999809265137,"no_speech_prob":0.0004509045393206179},{"id":62,"seek":19506,"start":208.02000427246094,"end":211.02000427246094,"text":" on a US-based service.","tokens":[51012,322,257,2546,12,6032,2643,13,51162],"temperature":0.0,"avg_logprob":-0.24818584322929382,"compression_ratio":1.5199999809265137,"no_speech_prob":0.0004509045393206179},{"id":63,"seek":19506,"start":211.02000427246094,"end":216.3800048828125,"text":" So for data sharing side, this is totally fine.","tokens":[51162,407,337,1412,5414,1252,11,341,307,3879,2489,13,51430],"temperature":0.0,"avg_logprob":-0.24818584322929382,"compression_ratio":1.5199999809265137,"no_speech_prob":0.0004509045393206179},{"id":64,"seek":19506,"start":216.3800048828125,"end":220.6199951171875,"text":" Revolute, in particular, because we're a EU-regulated bank,","tokens":[51430,1300,9646,1169,11,294,1729,11,570,321,434,257,10887,12,3375,6987,3765,11,51642],"temperature":0.0,"avg_logprob":-0.24818584322929382,"compression_ratio":1.5199999809265137,"no_speech_prob":0.0004509045393206179},{"id":65,"seek":22062,"start":220.6199951171875,"end":225.3000030517578,"text":" we fall under the most strict regime in terms of compliance.","tokens":[50364,321,2100,833,264,881,10910,13120,294,2115,295,15882,13,50598],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":66,"seek":22062,"start":225.3000030517578,"end":229.6199951171875,"text":" And so what we find that works is all of these coding tasks","tokens":[50598,400,370,437,321,915,300,1985,307,439,295,613,17720,9608,50814],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":67,"seek":22062,"start":229.6199951171875,"end":232.77999877929688,"text":" are not considered autonomous agents.","tokens":[50814,366,406,4888,23797,12554,13,50972],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":68,"seek":22062,"start":232.77999877929688,"end":235.02000427246094,"text":" They're always with a human in the loop.","tokens":[50972,814,434,1009,365,257,1952,294,264,6367,13,51084],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":69,"seek":22062,"start":235.02000427246094,"end":236.77999877929688,"text":" And so how do you give reassurance","tokens":[51084,400,370,577,360,291,976,19486,5683,51172],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":70,"seek":22062,"start":236.77999877929688,"end":239.55999755859375,"text":" that you have a human in the loop?","tokens":[51172,300,291,362,257,1952,294,264,6367,30,51311],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":71,"seek":22062,"start":239.55999755859375,"end":242.86000061035156,"text":" You start by creating a sandbox that guarantees that.","tokens":[51311,509,722,538,4084,257,42115,300,32567,300,13,51476],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":72,"seek":22062,"start":242.86000061035156,"end":246.02000427246094,"text":" And the sandbox means now, if you've used Codecs load code,","tokens":[51476,400,264,42115,1355,586,11,498,291,600,1143,15549,14368,3677,3089,11,51634],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":73,"seek":22062,"start":246.02000427246094,"end":249.02000427246094,"text":" it has all of these features of approve for me.","tokens":[51634,309,575,439,295,613,4122,295,18827,337,385,13,51784],"temperature":0.0,"avg_logprob":-0.2702992260456085,"compression_ratio":1.68359375,"no_speech_prob":0.00018230143177788705},{"id":74,"seek":24902,"start":249.02000427246094,"end":251.25999450683594,"text":" You just have to set the rules for the operations","tokens":[50364,509,445,362,281,992,264,4474,337,264,7705,50476],"temperature":0.0,"avg_logprob":-0.26625940203666687,"compression_ratio":1.6964285373687744,"no_speech_prob":0.0001881037896964699},{"id":75,"seek":24902,"start":251.25999450683594,"end":252.6999969482422,"text":" that you don't want to allow.","tokens":[50476,300,291,500,380,528,281,2089,13,50548],"temperature":0.0,"avg_logprob":-0.26625940203666687,"compression_ratio":1.6964285373687744,"no_speech_prob":0.0001881037896964699},{"id":76,"seek":24902,"start":252.6999969482422,"end":256.2200012207031,"text":" So you can allow grep, but not gradle, for instance.","tokens":[50548,407,291,393,2089,6066,79,11,457,406,2771,306,11,337,5197,13,50724],"temperature":0.0,"avg_logprob":-0.26625940203666687,"compression_ratio":1.6964285373687744,"no_speech_prob":0.0001881037896964699},{"id":77,"seek":24902,"start":256.2200012207031,"end":258.5799865722656,"text":" And that's going to give confidence to your regulator","tokens":[50724,400,300,311,516,281,976,6687,281,428,36250,50842],"temperature":0.0,"avg_logprob":-0.26625940203666687,"compression_ratio":1.6964285373687744,"no_speech_prob":0.0001881037896964699},{"id":78,"seek":24902,"start":258.5799865722656,"end":261.4200134277344,"text":" that it's not an autonomous agent that","tokens":[50842,300,309,311,406,364,23797,9461,300,50984],"temperature":0.0,"avg_logprob":-0.26625940203666687,"compression_ratio":1.6964285373687744,"no_speech_prob":0.0001881037896964699},{"id":79,"seek":24902,"start":261.4200134277344,"end":264.89999