},{"id":61,"seek":28828,"start":308.8399963378906,"end":313.8399963378906,"text":" of staff kind of agents that keep a tab on what the state of the organization is and","tokens":[51392,295,3525,733,295,12554,300,1066,257,4421,322,437,264,1785,295,264,4475,307,293,51642],"temperature":0.0,"avg_logprob":-0.27595722675323486,"compression_ratio":1.875,"no_speech_prob":0.02228316105902195},{"id":62,"seek":28828,"start":313.8399963378906,"end":315.79998779296875,"text":" what needs to be done.","tokens":[51642,437,2203,281,312,1096,13,51740],"temperature":0.0,"avg_logprob":-0.27595722675323486,"compression_ratio":1.875,"no_speech_prob":0.02228316105902195},{"id":63,"seek":31580,"start":315.79998779296875,"end":321.5199890136719,"text":" So going back to our workflows, A, again, is looking at this very differently in terms","tokens":[50364,407,516,646,281,527,43461,11,316,11,797,11,307,1237,412,341,588,7614,294,2115,50650],"temperature":0.0,"avg_logprob":-0.29495304822921753,"compression_ratio":1.5474138259887695,"no_speech_prob":0.004608914256095886},{"id":64,"seek":31580,"start":321.5199890136719,"end":322.5199890136719,"text":" of shared capabilities.","tokens":[50650,295,5507,10862,13,50700],"temperature":0.0,"avg_logprob":-0.29495304822921753,"compression_ratio":1.5474138259887695,"no_speech_prob":0.004608914256095886},{"id":65,"seek":31580,"start":322.5199890136719,"end":329.8399963378906,"text":" Now, the last pillar here that I want to draw your attention to is, well, when does this","tokens":[50700,823,11,264,1036,27592,510,300,286,528,281,2642,428,3202,281,307,11,731,11,562,775,341,51066],"temperature":0.0,"avg_logprob":-0.29495304822921753,"compression_ratio":1.5474138259887695,"no_speech_prob":0.004608914256095886},{"id":66,"seek":31580,"start":329.8399963378906,"end":331.760009765625,"text":" system really comp on?","tokens":[51066,1185,534,715,322,30,51162],"temperature":0.0,"avg_logprob":-0.29495304822921753,"compression_ratio":1.5474138259887695,"no_speech_